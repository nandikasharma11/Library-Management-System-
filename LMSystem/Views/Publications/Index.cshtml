@model IEnumerable<LMSystem.Models.Publication>
@{
    string currentType = ViewData["CurrentType"]?.ToString() ?? "Newspaper";
    ViewData["Title"] = currentType + " Management";
    int pageNumber = (int)(ViewData["PageNumber"] ?? 1);
    int totalPages = (int)(ViewData["TotalPages"] ?? 1);
}

<!-- Top Action Bar Matching Your UI Blueprint -->
<div class="d-flex justify-content-between align-items-center my-3">
    <h2>@ViewData["Title"]</h2>
    <div class="d-flex gap-3 align-items-center">
        <a asp-action="Create" asp-route-type="@currentType" class="btn btn-primary">Add New @currentType</a>
        <form asp-action="Index" method="get" asp-route-type="@currentType" class="d-flex gap-2">
            <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control" placeholder="Search..." style="width: 250px;" />
            <button type="submit" class="btn btn-outline-secondary">Search</button>
        </form>
    </div>
</div>

<!-- Main Table Layout -->
<table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>Title</th>
            <th>Publisher</th>
            <th>Published Date</th>
            <th>Availability</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Title</td>
                <td>@item.Publisher</td>
                <td>@item.PublishedDate.ToString("yyyy-MM-dd")</td>
                <td>
                    <span class="badge @(item.IsAvailable ? "bg-success" : "bg-danger")">
                        @(item.IsAvailable ? "Available" : "Checked Out")
                    </span>
                </td>
                <td>
                    <div class="btn-group btn-group-sm" role="group">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning text-white">Edit</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger">Delete</a>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Pagination Footers Matching UI Layout Blueprint -->
@if (totalPages > 1)
{
    <nav aria-label="Page navigation">
        <ul class="pagination">
            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == pageNumber ? "active" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-type="@currentType"
                       asp-route-searchString="@ViewData["CurrentFilter"]"
                       asp-route-pageNumber="@i">@i</a>
                </li>
            }
        </ul>
    </nav>
}
