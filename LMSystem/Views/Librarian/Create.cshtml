@model LMSystem.Models.LibrarianModel
@{
    ViewData["Title"] = "Add Librarian";
}

<div class="container mt-4" style="max-width: 600px;">
    <h2>Add Librarian</h2>
    <form asp-action="Create" method="post" onsubmit="return validateForm();">
        @Html.AntiForgeryToken()
        <div class="mb-3">
            <label asp-for="Name" class="form-label">Name</label>
            <input asp-for="Name" class="form-control" name="Name" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Age" class="form-label">Age</label>
            <input asp-for="Age" class="form-control" name="Age" type="number" />
            <span asp-validation-for="Age" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Phone" class="form-label">Phone</label>
            <input asp-for="Phone" class="form-control" name="Phone" />
            <span asp-validation-for="Phone" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-success">Add</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>

<script>
    function validateForm() {
        const name = document.querySelector('[name="Name"]').value.trim();
        const age = document.querySelector('[name="Age"]').value.trim();
        const phone = document.querySelector('[name="Phone"]').value.trim();
        if (!name || !age || !phone) {
            alert("All fields are required: Name, Age, Phone.");
            return false; // prevent form submission
        }
        return true; // allow submission
    }
</script>
