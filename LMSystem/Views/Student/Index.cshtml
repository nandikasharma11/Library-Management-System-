@model LMSystem.Models.StudentIndexViewModel
@{
    ViewData["Title"] = "Students";
}

<div class="container mt-4">
    <div class="row align-items-center mb-3">
        <div class="col-md-6">
            <h2>Students</h2>
            <a class="btn btn-primary" href="/Student/Create">Add New Student</a>
        </div>
        <div class="col-md-6">
            <form method="get" action="/Student/Index" class="d-flex justify-content-end gap-2">
                <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Search by name, email, phone..." style="width: 250px;" />
                <button type="submit" class="btn btn-outline-success">Search</button>
                @if (!string.IsNullOrEmpty(Model.SearchTerm))
                {
                    <a href="/Student/Index" class="btn btn-outline-secondary">Clear</a>
                }
            </form>
        </div>
    </div>

    <table class="table table-bordered">
        <thead class="table-dark">
            <tr>
                <th>StudentID</th>
                <th>StudentName</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Students != null && Model.Students.Any())
            {
                @foreach (var item in Model.Students)
                {
                    <tr>
                        <td>@item.StudentId</td>
                        <td>@item.StudentName</td>
                        <td>@item.Email</td>
                        <td>@item.Phone</td>
                        <td>
                            <a class="btn btn-warning btn-sm" href="/Student/Edit/@item.StudentId">Edit</a>
                            <a class="btn btn-danger btn-sm" href="/Student/Delete/@item.StudentId" onclick="return confirm('Are you sure?')">Delete</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center text-muted">No student records found matching the criteria.</td>
                </tr>
            }
        </tbody>
    </table>

    <!-- Pagination Controls -->
    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Student management page navigation" class="mt-3">
            <ul class="pagination justify-content-center">
                <!-- Previous Button -->
                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link" href="/Student/Index?searchTerm=@Model.SearchTerm&page=@(Model.CurrentPage - 1)">Previous</a>
                </li>
                <!-- Page Number Links -->
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                        <a class="page-link" href="/Student/Index?searchTerm=@Model.SearchTerm&page=@i">@i</a>
                    </li>
                }
                <!-- Next Button -->
                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" href="/Student/Index?searchTerm=@Model.SearchTerm&page=@(Model.CurrentPage + 1)">Next</a>
                </li>
            </ul>
        </nav>
    }
</div>
