@model LMSystem.Models.LibrarianIndexViewModel
@{
    ViewData["Title"] = "Librarians";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <a class="btn btn-primary" href="/Librarian/Create">Add New Librarian</a>
        
        <!-- Inline Search Form -->
        <form method="get" action="/Librarian/Index" class="d-flex gap-2">
            <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Search by name..." style="width: 250px;" />
            <button type="submit" class="btn btn-secondary">Search</button>
            @if (!string.IsNullOrEmpty(Model.SearchTerm))
            {
                <a href="/Librarian/Index" class="btn btn-outline-danger">Clear</a>
            }
        </form>
    </div>

    <table class="table table-bordered">
        <thead class="table-dark">
            <tr>
                <th>LibrarianID</th>
                <th>Name</th>
                <th>Age</th>
                <th>Phone</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Librarians != null && Model.Librarians.Any())
            {
                @foreach (var item in Model.Librarians)
                {
                    <tr>
                        <td>@item.LibrarianId</td>
                        <td>@item.Name</td>
                        <td>@item.Age</td>
                        <td>@item.Phone</td>
                        <td>
                            <a class="btn btn-warning btn-sm" href="/Librarian/Edit/@item.LibrarianId">Edit</a>
                            <a class="btn btn-danger btn-sm" href="/Librarian/Delete/@item.LibrarianId" onclick="return confirm('Are you sure?')">Delete</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center text-muted">No librarian records found matching the criteria.</td>
                </tr>
            }
        </tbody>
    </table>

    <!-- Pagination Controls -->
    @if (Model.TotalPages > 1)
    {
        <nav class="mt-3">
            <ul class="pagination justify-content-center">
                <!-- Previous Button -->
                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link" href="/Librarian/Index?searchTerm=@Model.SearchTerm&page=@(Model.CurrentPage - 1)">Previous</a>
                </li>
                <!-- Page Numbers -->
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                        <a class="page-link" href="/Librarian/Index?searchTerm=@Model.SearchTerm&page=@i">@i</a>
                    </li>
                }
                <!-- Next Button -->
                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" href="/Librarian/Index?searchTerm=@Model.SearchTerm&page=@(Model.CurrentPage + 1)">Next</a>
                </li>
            </ul>
        </nav>
    }
</div>
