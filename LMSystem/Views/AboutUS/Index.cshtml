@{
    ViewData["Title"] = "About Us";
}

<div class="container mt-5">
    <div class="card shadow-sm p-4">
        <h2 class="text-primary border-bottom pb-2 mb-4">About Our Library Management System</h2>
        <p class="lead">
            Welcome to the **Library Management System (LMSystem)**, a modern solution for managing books, publications, members, and library workflows.
        </p>
        <p>
            Our mission is to simplify administrative tasks for librarians while providing users with seamless access to resources such as books, newspapers, and magazines.
        </p>
        <h4 class="mt-4">Features</h4>
        <ul>
            <li>Dynamic Cataloging for Books, Magazines, and Newspapers.</li>
            <li>Real-time Check-out (Borrowing) and Check-in (Returning) tracking.</li>
            <li>Role-Based Administration with Secure Login.</li>
            <li>Comprehensive Dashboards displaying system statistics.</li>
        </ul>
    </div>
</div>
