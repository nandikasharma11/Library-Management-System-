@{
    ViewData["Title"] = "Home Page";
}

<!-- Featured Books Section -->
<div class="row my-5">
    <div class="col-12">
        <h2 class="text-center text-primary">Featured Books</h2>
        <hr>
    </div>
    
    <!-- The Hobbit Card -->
    <div class="col-md-4 mb-4">
        <div class="card h-100 shadow-sm">
            <img src="/images/hobbit.jpeg" class="card-img-top" alt="The Hobbit" style="height: 250px; object-fit: cover;" />
            <div class="card-body d-flex flex-column justify-content-between">
                <div>
                    <h5 class="card-title text-dark">The Hobbit</h5>
                    <p class="card-text text-muted">
                        A hobbit named Bilbo embarks on an unexpected journey with dwarves to reclaim their homeland from a dragon.
                    </p>
                </div>
                <a href="/Books/Details/1" class="btn btn-primary mt-3">View Details</a>
            </div>
        </div>
    </div>
    
    <!-- War and Peace Card -->
    <div class="col-md-4 mb-4">
        <div class="card h-100 shadow-sm">
            <img src="/images/warpeace.jpeg" class="card-img-top" alt="War and Peace" style="height: 250px; object-fit: cover;" />
            <div class="card-body d-flex flex-column justify-content-between">
                <div>
                    <h5 class="card-title text-dark">War and Peace</h5>
                    <p class="card-text text-muted">
                        Leo Tolstoy explores the impact of the Napoleonic Wars on Russian aristocratic families, interweaving personal dramas with historical events.
                    </p>
                </div>
                <a href="/Books/Details/3" class="btn btn-primary mt-3">View Details</a>
            </div>
        </div>
    </div>
    
    <!-- Purple Hearts Card -->
    <div class="col-md-4 mb-4">
        <div class="card h-100 shadow-sm">
            <img src="/images/purple.png" class="card-img-top" alt="Purple Hearts" style="height: 250px; object-fit: cover;" />
            <div class="card-body d-flex flex-column justify-content-between">
                <div>
                    <h5 class="card-title text-dark">Purple Hearts</h5>
                    <p class="card-text text-muted">
                        Follows a sergeant and a soldier who are thrown together in the midst of war. Their relationship evolves into a story of connection.
                    </p>
                </div>
                <a href="/Books/Details/3" class="btn btn-primary mt-3">View Details</a>
            </div>
        </div>
    </div>
</div>

<!-- Announcements Section -->
<div class="row my-5">
    <div class="col-12">
        <h2 class="text-center text-primary">Library Announcements</h2>
        <hr>
    </div>
    <div class="col-md-12">
        <div class="alert alert-info" role="alert">
            <strong>New Arrivals:</strong> Check out the latest books and publications added to our collection!
        </div>
        <div class="alert alert-warning" role="alert">
            <strong>Library Hours Update:</strong> The library will be closed on upcoming public holidays.
        </div>
    </div>
</div>
